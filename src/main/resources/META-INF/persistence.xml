<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="stockPU" transaction-type="RESOURCE_LOCAL">
        <!-- No es obligatorio listar clases si uso auto-scan, pero ayuda -->
        <class>Persistencia.Clases.Item</class>
        <class>Persistencia.Clases.ItemDeProveedorX</class>
        <class>Persistencia.Clases.ItemDeSTOCK</class>
        <class>Persistencia.Clases.Proveedor</class>
        <class>Persistencia.Clases.Stock</class>
        <class>Persistencia.Clases.Usuario</class>

        <properties>
            <!-- JDBC -->
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mysql://localhost:3306/stockappDB?useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=UTC"/>
            <property name="jakarta.persistence.jdbc.user" value="StockUser"/>
            <property name="jakarta.persistence.jdbc.password" value="StockPass"/>

            <!-- Hibernate -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <!-- create = recrea to do, update = intenta mantener y actualizar -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>